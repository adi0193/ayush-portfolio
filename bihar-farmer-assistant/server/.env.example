# Copy to .env and fill in. Never commit real keys.
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Mandi prices: data.gov.in Open Government Data API key (free registration at data.gov.in).
# Without it, the API returns "live data unavailable" - it never invents prices.
DATA_GOV_IN_API_KEY=
# Resource id of "Current Daily Price of Various Commodities from Various Markets (Mandi)".
# Verify on data.gov.in before production; it is configurable because resource ids can change.
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional LLM for phrasing answers grounded in retrieved facts. Without it, a rule-based
# template engine answers (fully functional, less fluent).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Protects the content-review admin endpoints.
ADMIN_TOKEN=change-me
